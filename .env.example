# Copie estas variáveis para o ambiente local ou para os GitHub Actions Secrets.
# Nunca use a chave service_role dentro do aplicativo.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_OU_PUBLISHABLE

# Assinatura de release (opcional no desenvolvimento local).
AGRO_RELEASE_STORE_FILE=CAMINHO_RELATIVO_DO_KEYSTORE
AGRO_RELEASE_STORE_PASSWORD=SENHA_DO_KEYSTORE
AGRO_RELEASE_KEY_ALIAS=ALIAS_DA_CHAVE
AGRO_RELEASE_KEY_PASSWORD=SENHA_DA_CHAVE
