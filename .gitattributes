* text=auto

# Keep source and Unix scripts portable across Windows, macOS and Linux.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.html text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary artifacts must never receive line-ending conversion.
*.jar binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
